{
  "name": "repomap-vscode",
  "displayName": "Repomap - AI Codebase Visualizer",
  "description": "AI-powered codebase visualization and editing tool powered by IBM Bob",
  "version": "1.0.0",
  "publisher": "primates",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "codebase",
    "visualization",
    "ai",
    "ibm bob",
    "graph"
  ],
  "activationEvents": [
    "onCommand:repomap.openPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repomap.openPanel",
        "title": "Open Repomap",
        "category": "Repomap"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "build:webview": "cd ../webview && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {}
}